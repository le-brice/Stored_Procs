{"data":{"node_info":{"unique_id":"model.retail_dw.int_suppliers"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_suppliers\n  \n  \n  \n  \n  as (\n    with raw_suppliers as (\n    select distinct supplier_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where supplier_name is not null\n      and supplier_name not in (\n          select supplier_name from analytics.dbt_cbuckley_dev.stg_suppliers\n      )\n)\n\nselect\n    supplier_id,\n    supplier_name,\n    country_code,\n    lead_time_days,\n    is_active\nfrom analytics.dbt_cbuckley_dev.stg_suppliers\n\nunion all\n\nselect\n    100000 + row_number() over (order by supplier_name) as supplier_id,\n    supplier_name,\n    null as country_code,\n    7 as lead_time_days,\n    1 as is_active\nfrom raw_suppliers\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_suppliers\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:13.233062+00:00\n-- finished_at: 2026-07-30T12:50:13.807267+00:00\n-- elapsed: 574ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_suppliers\n-- query_id: 01c60e02-090c-eee0-0004-7d833f39290e\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_suppliers\n  \n  \n  \n  \n  as (\n    with raw_suppliers as (\n    select distinct supplier_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where supplier_name is not null\n      and supplier_name not in (\n          select supplier_name from analytics.dbt_cbuckley_dev.stg_suppliers\n      )\n)\n\nselect\n    supplier_id,\n    supplier_name,\n    country_code,\n    lead_time_days,\n    is_active\nfrom analytics.dbt_cbuckley_dev.stg_suppliers\n\nunion all\n\nselect\n    100000 + row_number() over (order by supplier_name) as supplier_id,\n    supplier_name,\n    null as country_code,\n    7 as lead_time_days,\n    1 as is_active\nfrom raw_suppliers\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_suppliers\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:13.807280Z"}}
