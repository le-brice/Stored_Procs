{"data":{"sql":"EXECUTE IMMEDIATE $$\nbegin\n    let objects array := array_construct(\n        '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"STOCK_LEVEL\"', '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"CONFIG_PARAM\"', '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"PRODUCT\"', '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"RAW_PRODUCT\"', '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"PRODUCT_CATEGORY\"', '\"ANALYTICS\".\"DBT_CBUCKLEY_STORED_PROC\".\"SUPPLIER\"'\n    );\n\n    let i integer := 0;\n    let results array := array_construct();\n\n    while (i < array_size(objects)) do\n        let obj_name string := objects[i]::string;\n\n        begin\n            let ddl_text string := (select get_ddl('VIEW', :obj_name));\n\n            results := array_append(results, object_construct(\n                'OBJECT_NAME', :obj_name,\n                'DEFINITION', :ddl_text,\n                'ERROR', null\n            ));\n\n        exception\n            when other then\n                results := array_append(results, object_construct(\n                    'OBJECT_NAME', :obj_name,\n                    'DEFINITION', null,\n                    'ERROR', :sqlerrm\n                ));\n        end;\n\n        i := i + 1;\n    end while;\n\n    let rs resultset := (\n        select\n            f.value['OBJECT_NAME']::string as fqn,\n            f.value['DEFINITION']::string as view_definition,\n            f.value['ERROR']::string as error\n        from table(flatten(input => :results)) f\n        order by 1\n    );\n\n    return table(rs);\nend;$$"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a26-63b6-7ff1-b583-072798a7d36f","level":"debug","msg":"-- created_at: 2026-06-30T20:09:31.432266+00:00\n-- finished_at: 2026-06-30T20:09:33.168615+00:00\n-- elapsed: 1.7s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: not available\n-- query_id: 01c566f9-0a0c-6ce7-0004-7d833bcb3546\n-- desc: Fetch view definitions\nEXECUTE IMMEDIATE $$\nbegin\n    le