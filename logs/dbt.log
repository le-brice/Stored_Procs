{"data":{"compiled":"with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_dev.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005","is_inline":false,"node_name":"assert_order_totals_reconcile","output_format":"text","unique_id":"test.retail_dw.assert_order_totals_reconcile"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019fb311-d36d-7e31-b184-53a654fc7992","level":"info","msg":"with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_dev.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005","name":"CompiledNode","pid":33055,"thread":"tokio-rt-worker","ts":"2026-07-30T12:48:38.316641Z"}}
{"data":{"compiled":"select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join analytics.dbt_cbuckley_dev.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3","is_inline":false,"node_name":"rpt_top_products_by_revenue","output_format":"text","unique_id":"model.retail_dw.rpt_top_products_by_revenue"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019fb311-d36d-7e31-b184-53a654fc7992","level":"info","msg":"select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join analytics.dbt_cbuckley_dev.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3","name":"CompiledNode","pid":33055,"thread":"tokio-rt-worker","ts":"2026-07-30T12:48:38.316707Z"}}
