{"data":{"node_info":{"unique_id":"model.my_new_project.rpt_reorder_recommendations"},"sql":"create or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_reorder_recommendations\n    \n    \n    \n    \n    as (select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.rpt_reorder_recommendations\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:22.033614+00:00\n-- finished_at: 2026-06-30T20:05:24.691898+00:00\n-- elapsed: 2.7s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.rpt_reorder_recommendations\n-- query_id: 01c566f5-0a0c-7241-0004-7d833bcae83a\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_reorder_recommendations\n    \n    \n    \n    \n    as (select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.rpt_reorder_recommendations\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57042,"thread":"tokio-rt-worker","ts":"2026-06-30T20:05:24.691931Z"}}
