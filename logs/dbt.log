{"data":{"node_info":{"unique_id":"model.retail_dw.stg_raw_fx_rates"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.stg_raw_fx_rates\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by fromcurrency, tocurrency, ratedatetext) as row_id,\n    nullif(trim(fromcurrency), '') as from_currency,\n    nullif(trim(tocurrency), '') as to_currency,\n    try_to_date(nullif(trim(ratedatetext), '')) as rate_date,\n    try_to_decimal(nullif(trim(ratetext), ''), 18, 8) as rate\nfrom analytics.dbt_cbuckley_dev.raw_fxrate\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_fx_rates\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:11.594694+00:00\n-- finished_at: 2026-07-30T12:50:11.995460+00:00\n-- elapsed: 400ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.stg_raw_fx_rates\n-- query_id: 01c60e02-090c-eee0-0004-7d833f3928e2\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.stg_raw_fx_rates\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by fromcurrency, tocurrency, ratedatetext) as row_id,\n    nullif(trim(fromcurrency), '') as from_currency,\n    nullif(trim(tocurrency), '') as to_currency,\n    try_to_date(nullif(trim(ratedatetext), '')) as rate_date,\n    try_to_decimal(nullif(trim(ratetext), ''), 18, 8) as rate\nfrom analytics.dbt_cbuckley_dev.raw_fxrate\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_fx_rates\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:11.995479Z"}}
