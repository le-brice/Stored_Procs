{"data":{"node_info":{"unique_id":"model.retail_dw.int_product_master"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_product_master\n  \n  \n  \n  \n  as (\n    with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_dev.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_dev.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_dev.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_dev.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom analytics.dbt_cbuckley_dev.stg_products\n\nunion all\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom raw_products\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_product_master\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:14.144230+00:00\n-- finished_at: 2026-07-30T12:50:14.877018+00:00\n-- elapsed: 732ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_product_master\n-- query_id: 01c60e02-090c-e778-0004-7d833f390d06\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_product_master\n  \n  \n  \n  \n  as (\n    with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_dev.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_dev.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_dev.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_dev.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom analytics.dbt_cbuckley_dev.stg_products\n\nunion all\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom raw_products\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_product_master\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:14.877034Z"}}
