{"data":{"node_info":{"unique_id":"model.retail_dw.int_order_usd_rates"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_order_usd_rates\n  \n  \n  \n  \n  as (\n    with non_usd_rates as (\n    select\n        orders.order_id,\n        fx.rate\n    from analytics.dbt_cbuckley_dev.fct_orders as orders\n    left join analytics.dbt_cbuckley_dev.int_fx_rates as fx\n        on fx.from_currency = orders.currency_code\n        and fx.to_currency = 'USD'\n        and fx.rate_date <= orders.order_date\n    where orders.currency_code <> 'USD'\n    qualify row_number() over (\n        partition by orders.order_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    orders.order_id,\n    case\n        when orders.currency_code = 'USD' then 1\n        else coalesce(non_usd_rates.rate, 1)\n    end as usd_rate\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\nleft join non_usd_rates\n    on non_usd_rates.order_id = orders.order_id\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_order_usd_rates\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:41.761505+00:00\n-- finished_at: 2026-07-30T12:50:42.373702+00:00\n-- elapsed: 612ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_order_usd_rates\n-- query_id: 01c60e02-090c-eee0-0004-7d833f39297a\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_order_usd_rates\n  \n  \n  \n  \n  as (\n    with non_usd_rates as (\n    select\n        orders.order_id,\n        fx.rate\n    from analytics.dbt_cbuckley_dev.fct_orders as orders\n    left join analytics.dbt_cbuckley_dev.int_fx_rates as fx\n        on fx.from_currency = orders.currency_code\n        and fx.to_currency = 'USD'\n        and fx.rate_date <= orders.order_date\n    where orders.currency_code <> 'USD'\n    qualify row_number() over (\n        partition by orders.order_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    orders.order_id,\n    case\n        when orders.currency_code = 'USD' then 1\n        else coalesce(non_usd_rates.rate, 1)\n    end as usd_rate\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\nleft join non_usd_rates\n    on non_usd_rates.order_id = orders.order_id\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_order_usd_rates\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:42.373714Z"}}
