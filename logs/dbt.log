{"data":{"node_info":{"unique_id":"model.my_new_project.rpt_low_stock_report"},"sql":"create or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_low_stock_report\n    \n    \n    \n    \n    as (select\n    snapshot.warehouse_id,\n    snapshot.product_id,\n    product.sku,\n    product.product_name,\n    supplier.supplier_name,\n    snapshot.qty_available,\n    stock.qty_on_order as on_order\nfrom analytics.dbt_cbuckley_stored_proc.rpt_inventory_snapshot as snapshot\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = snapshot.product_id\nleft join analytics.dbt_cbuckley_stored_proc.int_suppliers as supplier\n    on supplier.supplier_id = product.supplier_id\nleft join analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\n    on stock.warehouse_id = snapshot.warehouse_id\n    and stock.product_id = snapshot.product_id\nwhere snapshot.below_reorder = 1\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.rpt_low_stock_report\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:28.572907+00:00\n-- finished_at: 2026-06-30T20:05:30.858597+00:00\n-- elapsed: 2.3s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.rpt_low_stock_report\n-- query_id: 01c566f5-0a0c-6cd9-0004-7d833bcad88e\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_low_stock_report\n    \n    \n    \n    \n    as (select\n    snapshot.warehouse_id,\n    snapshot.product_id,\n    product.sku,\n    product.product_name,\n    supplier.supplier_name,\n    snapshot.qty_available,\n    stock.qty_on_order as on_order\nfrom analytics.dbt_cbuckley_stored_proc.rpt_inventory_snapshot as snapshot\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = snapshot.product_id\nleft join analytics.dbt_cbuckley_stored_proc.int_suppliers as supplier\n    on supplier.supplier_id = product.supplier_id\nleft join analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\n    on stock.warehouse_id = snapshot.warehouse_id\n    and stock.product_id = snapshot.product_id\nwhere snapshot.below_reorder = 1\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.rpt_low_stock_report\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57042,"thread":"tokio-rt-worker","ts":"2026-06-30T20:05:30.858628Z"}}
