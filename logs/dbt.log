{"data":{"node_info":{"unique_id":"model.retail_dw.stg_raw_products"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.stg_raw_products\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by sku, productname) as row_id,\n    nullif(trim(sku), '') as sku,\n    nullif(trim(productname), '') as product_name,\n    nullif(trim(categoryname), '') as category_name,\n    nullif(trim(suppliername), '') as supplier_name,\n    try_to_decimal(nullif(trim(unitcost), ''), 18, 4) as unit_cost,\n    try_to_decimal(nullif(trim(listprice), ''), 18, 4) as list_price\nfrom analytics.dbt_cbuckley_dev.raw_product\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_products\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:12.413935+00:00\n-- finished_at: 2026-07-30T12:50:12.881065+00:00\n-- elapsed: 467ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.stg_raw_products\n-- query_id: 01c60e02-090c-ee4d-0004-7d833f3937be\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.stg_raw_products\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by sku, productname) as row_id,\n    nullif(trim(sku), '') as sku,\n    nullif(trim(productname), '') as product_name,\n    nullif(trim(categoryname), '') as category_name,\n    nullif(trim(suppliername), '') as supplier_name,\n    try_to_decimal(nullif(trim(unitcost), ''), 18, 4) as unit_cost,\n    try_to_decimal(nullif(trim(listprice), ''), 18, 4) as list_price\nfrom analytics.dbt_cbuckley_dev.raw_product\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_products\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:5