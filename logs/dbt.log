{"data":{"compiled":"select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null","is_inline":false,"node_name":"rpt_reorder_recommendations","output_format":"text","unique_id":"model.my_new_project.rpt_reorder_recommendations"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019f1a21-6505-75e1-814a-d59962ae16ae","level":"info","msg":"select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_stored_proc.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null","name":"CompiledNode","pid":56943,"thread":"tokio-rt-worker","ts":"2026-06-30T20:03:44.39836