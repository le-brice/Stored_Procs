{"data":{"node_info":{"unique_id":"model.retail_dw.int_order_line_inputs"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_order_line_inputs\n  \n  \n  \n  \n  as (\n    with valid_lines as (\n    select raw.*\n    from analytics.dbt_cbuckley_dev.int_raw_orders_validated as raw\n    inner join analytics.dbt_cbuckley_dev.int_valid_order_refs as orders\n        on orders.external_order_ref = raw.external_order_ref\n    where raw.reject_reason is null\n),\n\nprice_list_prices as (\n    select\n        line.row_id,\n        item.unit_price\n    from valid_lines as line\n    inner join analytics.dbt_cbuckley_dev.stg_price_lists as list\n        on list.currency_code = line.currency_code\n        and list.is_active = 1\n        and list.effective_from <= line.order_date\n        and (list.effective_to is null or list.effective_to >= line.order_date)\n    inner join analytics.dbt_cbuckley_dev.stg_price_list_items as item\n        on item.price_list_id = list.price_list_id\n        and item.product_id = line.product_id\n    qualify row_number() over (\n        partition by line.row_id\n        order by list.effective_from desc\n    ) = 1\n),\n\nlist_price_fx as (\n    select\n        line.row_id,\n        fx.rate\n    from valid_lines as line\n    inner join analytics.dbt_cbuckley_dev.int_product_master as product\n        on product.product_id = line.product_id\n    left join analytics.dbt_cbuckley_dev.int_fx_rates as fx\n        on fx.from_currency = 'USD'\n        and fx.to_currency = line.currency_code\n        and fx.rate_date <= line.order_date\n    qualify row_number() over (\n        partition by line.row_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    line.row_id,\n    line.external_order_ref,\n    line.customer_id,\n    line.order_date,\n    line.product_id,\n    line.qty,\n    coalesce(\n        line.unit_price,\n        price_list_prices.unit_price,\n        round(product.list_price * coalesce(list_price_fx.rate, 1), 4)\n    ) as unit_price,\n    case\n        when customer.country_code in ('GB', 'FR') then 0.2000\n        when customer.country_code = 'IE' then 0.2300\n        when customer.country_code = 'DE' then 0.1900\n        when customer.country_code = 'CA' then 0.0500\n        else 0.0000\n    end as base_tax_rate,\n    case\n        when product.category_id in (12, 19) and customer.country_code in ('GB', 'IE') then 0.0000\n        when customer.country_code in ('GB', 'FR') then 0.2000\n        when customer.country_code = 'IE' then 0.2300\n        when customer.country_code = 'DE' then 0.1900\n        when customer.country_code = 'CA' then 0.0500\n        else 0.0000\n    end as tax_rate\nfrom valid_lines as line\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = line.product_id\ninner join analytics.dbt_cbuckley_dev.int_customer_master as customer\n    on customer.customer_id = line.customer_id\nleft join price_list_prices\n    on price_list_prices.row_id = line.row_id\nleft join list_price_fx\n    on list_price_fx.row_id = line.row_id\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_order_line_inputs\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:17.609724+00:00\n-- finished_at: 2026-07-30T12:50:19.233033+00:00\n-- elapsed: 1.6s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_order_line_inputs\n-- query_id: 01c60e02-090c-f17e-0004-7d833f3946d2\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_order_line_inputs\n  \n  \n  \n  \n  as (\n    with valid_lines as (\n    select raw.*\n    from analytics.dbt_cbuckley_dev.int_raw_orders_validated as raw\n    inner join analytics.dbt_cbuckley_dev.int_valid_order_refs as orders\n        on orders.external_order_ref = raw.external_order_ref\n    where raw.reject_reason is null\n),\n\nprice_list_prices as (\n    select\n        line.row_id,\n        item.unit_price\n    from valid_lines as line\n    inner join analytics.dbt_cbuckley_dev.stg_price_lists as list\n        on list.currency_code = line.currency_code\n        and list.is_active = 1\n        and list.effective_from <= line.order_date\n        and (list.effective_to is null or list.effective_to >= line.order_date)\n    inner join analytics.dbt_cbuckley_dev.stg_price_list_items as item\n        on item.price_list_id = list.price_list_id\n        and item.product_id = line.product_id\n    qualify row_number() over (\n        partition by line.row_id\n        order by list.effective_from desc\n    ) = 1\n),\n\nlist_price_fx as (\n    select\n        line.row_id,\n        fx.rate\n    from valid_lines as line\n    inner join analytics.dbt_cbuckley_dev.int_product_master as product\n        on product.product_id = line.product_id\n    left join analytics.dbt_cbuckley_dev.int_fx_rates as fx\n        on fx.from_currency = 'USD'\n        and fx.to_currency = line.currency_code\n        and fx.rate_date <= line.order_date\n    qualify row_number() over (\n        partition by line.row_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    line.row_id,\n    line.external_order_ref,\n    line.customer_id,\n    line.order_date,\n    line.product_id,\n    line.qty,\n    coalesce(\n        line.unit_price,\n        price_list_prices.unit_price,\n        round(product.list_price * coalesce(list_price_fx.rate, 1), 4)\n    ) as unit_price,\n    case\n        when customer.country_code in ('GB', 'FR') then 0.2000\n        when customer.country_code = 'IE' then 0.2300\n        when customer.country_code = 'DE' then 0.1900\n        when customer.country_code = 'CA' then 0.0500\n        else 0.0000\n    end as base_tax_rate,\n    case\n        when product.category_id in (12, 19) and customer.country_code in ('GB', 'IE') then 0.0000\n        when customer.country_code in ('GB', 'FR') then 0.2000\n        when customer.country_code = 'IE' then 0.2300\n        when customer.country_code = 'DE' then 0.1900\n        when customer.country_code = 'CA' then 0.0500\n        else 0.0000\n    end as tax_rate\nfrom valid_lines as line\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = line.product_id\ninner join analytics.dbt_cbuckley_dev.int_customer_master as customer\n    on customer.customer_id = line.customer_id\nleft join price_list_prices\n    on price_list_prices.row_id = line.row_id\nleft join list_price_fx\n    on list_price_fx.row_id = line.row_id\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_order_line_inputs\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:19.233051Z"}}
