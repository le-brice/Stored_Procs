{"data":{"node_info":{"unique_id":"model.retail_dw.int_config_values"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_config_values\n  \n  \n  \n  \n  as (\n    select\n    max(case when param_key = 'default.warehouse.code' then param_value end) as default_warehouse_code,\n    coalesce(\n        try_to_number(max(case when param_key = 'reorder.default.point' then param_value end)),\n        10\n    ) as default_reorder_point,\n    coalesce(\n        try_to_number(max(case when param_key = 'reorder.default.qty' then param_value end)),\n        50\n    ) as default_reorder_qty,\n    coalesce(\n        try_to_decimal(max(case when param_key = 'recon.tolerance' then param_value end), 18, 4),\n        0.01\n    ) as recon_tolerance\nfrom analytics.dbt_cbuckley_dev.stg_config_param\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_config_values\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:13.247133+00:00\n-- finished_at: 2026-07-30T12:50:13.742718+00:00\n-- elapsed: 495ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_config_values\n-- query_id: 01c60e02-090c-eee0-0004-7d833f392912\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_config_values\n  \n  \n  \n  \n  as (\n    select\n    max(case when param_key = 'default.warehouse.code' then param_value end) as default_warehouse_code,\n    coalesce(\n        try_to_number(max(case when param_key = 'reorder.default.point' then param_value end)),\n        10\n    ) as default_reorder_point,\n    coalesce(\n        try_to_number(max(case when param_key = 'reorder.default.qty' then param_value end)),\n        50\n    ) as default_reorder_qty,\n    coalesce(\n        try_to_decimal(max(case when param_key = 'recon.tolerance' then param_value end), 18, 4),\n        0.01\n    ) as recon_tolerance\nfrom analytics.dbt_cbuckley_dev.stg_config_param\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_config_values\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:13.742728Z"}}
