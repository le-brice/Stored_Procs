{"data":{"compiled":"with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005","is_inline":false,"node_name":"assert_order_totals_reconcile","output_format":"text","unique_id":"test.my_new_project.assert_order_totals_reconcile.00824ab001"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019f1a25-457d-7a33-814f-46b101479ead","level":"info","msg":"with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005","name":"CompiledNode","pid":57101,"thread":"tokio-rt-worker","ts":"2026-06-30T20:07:58.514205Z"}}
