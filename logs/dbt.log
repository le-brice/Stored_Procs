{"data":{"node_info":{"unique_id":"model.my_new_project.stg_raw_customers"},"sql":"create or replace   view analytics.dbt_cbuckley_stored_proc.stg_raw_customers\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by customerno, email) as row_id,\n    nullif(trim(customerno), '') as customer_no,\n    nullif(trim(firstname), '') as first_name,\n    nullif(trim(lastname), '') as last_name,\n    nullif(trim(email), '') as email,\n    nullif(trim(phone), '') as phone,\n    nullif(trim(country), '') as country_raw\nfrom analytics.dbt_cbuckley_stored_proc.raw_customer\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.stg_raw_customers\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:11.834552+00:00\n-- finished_at: 2026-06-30T20:05:13.044876+00:00\n-- elapsed: 1.2s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.stg_raw_customers\n-- query_id: 01c566f5-0a0c-6cc1-0004-7d833bcaacaa\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_stored_proc.stg_raw_customers\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by customerno, email) as row_id,\n    nullif(trim(customerno), '') as customer_no,\n    nullif(trim(firstname), '') as first_name,\n    nullif(trim(lastname), '') as last_name,\n    nullif(trim(email), '') as email,\n    nullif(trim(phone), '') as phone,\n    nullif(trim(country), '') as country_raw\nfrom analytics.dbt_cbuckley_stored_proc.raw_customer\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.stg_raw_customers\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","