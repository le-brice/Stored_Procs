{"data":{"node_info":{"unique_id":"model.retail_dw.stg_raw_orders"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.stg_raw_orders\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by externalorderref, sku, qty, unitpricetext) as row_id,\n    nullif(trim(externalorderref), '') as external_order_ref,\n    nullif(trim(customerno), '') as customer_no,\n    try_to_date(nullif(trim(orderdatetext), '')) as order_date,\n    nullif(trim(sku), '') as sku,\n    try_to_number(nullif(trim(qty), '')) as qty,\n    try_to_decimal(nullif(trim(unitpricetext), ''), 18, 4) as unit_price,\n    nullif(trim(promocode), '') as promo_code,\n    coalesce(nullif(trim(currencycode), ''), 'USD') as currency_code,\n    nullif(trim(sourcesystem), '') as source_system\nfrom analytics.dbt_cbuckley_dev.raw_order\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_orders\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:12.669232+00:00\n-- finished_at: 2026-07-30T12:50:13.080286+00:00\n-- elapsed: 411ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.stg_raw_orders\n-- query_id: 01c60e02-090c-ee4d-0004-7d833f3937c6\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.stg_raw_orders\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by externalorderref, sku, qty, unitpricetext) as row_id,\n    nullif(trim(externalorderref), '') as external_order_ref,\n    nullif(trim(customerno), '') as customer_no,\n    try_to_date(nullif(trim(orderdatetext), '')) as order_date,\n    nullif(trim(sku), '') as sku,\n    try_to_number(nullif(trim(qty), '')) as qty,\n    try_to_decimal(nullif(trim(unitpricetext), ''), 18, 4) as unit_price,\n    nullif(trim(promocode), '') as promo_code,\n    coalesce(nullif(trim(currencycode), ''), 'USD') as currency_code,\n    nullif(trim(sourcesystem), '') as source_system\nfrom analytics.dbt_cbuckley_dev.raw_order\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.stg_raw_orders\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:13.080295Z"}}
