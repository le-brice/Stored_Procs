{"data":{"compiled":"with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_stored_proc.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_stored_proc.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_stored_proc.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect * from analytics.dbt_cbuckley_stored_proc.stg_products\n\nunion all\n\nselect * from raw_products","is_inline":false,"node_name":"int_product_master","output_format":"text","unique_id":"model.my_new_project.int_product_master"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019f1a22-537f-7733-b954-8ffdbb717d72","level":"info","msg":"with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_stored_proc.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_stored_proc.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_stored_proc.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect * from analytics.dbt_cbuckley_stored_proc.stg_products\n\nunion all\n\nselect * from raw_products","name":"CompiledNode","pid":57034,"thread":"tokio-rt-worker","ts":"2026-06-30T20:04:45.455545Z"}}
