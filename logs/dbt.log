{"data":{"node_info":{"unique_id":"model.my_new_project.int_valid_order_refs"},"sql":"create or replace   view analytics.dbt_cbuckley_stored_proc.int_valid_order_refs\n  \n  \n  \n  \n  as (\n    select\n    external_order_ref,\n    max(customer_no) as customer_no,\n    max(customer_id) as customer_id,\n    coalesce(max(order_date), current_date()) as order_date,\n    max(currency_code) as currency_code,\n    max(promo_code) as promo_code,\n    max(source_system) as source_system\nfrom analytics.dbt_cbuckley_stored_proc.int_raw_orders_validated\nwhere external_order_ref is not null\ngroup by external_order_ref\nhaving count_if(reject_reason is not null) = 0\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.int_valid_order_refs\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:27.687479+00:00\n-- finished_at: 2026-06-30T20:05:28.766459+00:00\n-- elapsed: 1.1s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.int_valid_order_refs\n-- query_id: 01c566f5-0a0c-6cd9-0004-7d833bcad88a\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_stored_proc.int_valid_order_refs\n  \n  \n  \n  \n  as (\n    select\n    external_order_ref,\n    max(customer_no) as customer_no,\n    max(customer_id) as customer_id,\n    coalesce(max(order_date), current_date()) as order_date,\n    max(currency_code) as currency_code,\n    max(promo_code) as promo_code,\n    max(source_system) as source_system\nfrom analytics.dbt_cbuckley_stored_proc.int_raw_orders_validated\nwhere external_order_ref is not null\ngroup by external_order_ref\nhaving count_if(reject_reason is not null) = 0\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.int_valid_order_refs\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57042,"thread":"tokio-rt-worker","ts":"2026-06-30T20:05:28.766492Z"}}
