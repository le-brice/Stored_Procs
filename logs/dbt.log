{"data":{"node_info":{"unique_id":"model.retail_dw.rpt_top_products_by_revenue"},"sql":"create or replace transient  table analytics.dbt_cbuckley_dev.rpt_top_products_by_revenue\n    \n    \n    \n    \n    as (select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join analytics.dbt_cbuckley_dev.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_top_products_by_revenue\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:43.143232+00:00\n-- finished_at: 2026-07-30T12:50:44.629029+00:00\n-- elapsed: 1.5s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.rpt_top_products_by_revenue\n-- query_id: 01c60e02-090c-ee4d-0004-7d833f39388a\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_dev.rpt_top_products_by_revenue\n    \n    \n    \n    \n    as (select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join analytics.dbt_cbuckley_dev.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_top_products_by_revenue\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:44.629059Z"}}
