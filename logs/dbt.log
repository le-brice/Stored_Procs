{"data":{"node_info":{"unique_id":"model.retail_dw.int_valid_order_refs"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_valid_order_refs\n  \n  \n  \n  \n  as (\n    select\n    external_order_ref,\n    max(customer_no) as customer_no,\n    max(customer_id) as customer_id,\n    coalesce(max(order_date), current_date()) as order_date,\n    max(currency_code) as currency_code,\n    max(promo_code) as promo_code,\n    max(source_system) as source_system\nfrom analytics.dbt_cbuckley_dev.int_raw_orders_validated\nwhere external_order_ref is not null\ngroup by external_order_ref\nhaving count_if(reject_reason is not null) = 0\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_valid_order_refs\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:16.549649+00:00\n-- finished_at: 2026-07-30T12:50:17.276187+00:00\n-- elapsed: 726ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_valid_order_refs\n-- query_id: 01c60e02-090c-e778-0004-7d833f390d1e\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_valid_order_refs\n  \n  \n  \n  \n  as (\n    select\n    external_order_ref,\n    max(customer_no) as customer_no,\n    max(customer_id) as customer_id,\n    coalesce(max(order_date), current_date()) as order_date,\n    max(currency_code) as currency_code,\n    max(promo_code) as promo_code,\n    max(source_system) as source_system\nfrom analytics.dbt_cbuckley_dev.int_raw_orders_validated\nwhere external_order_ref is not null\ngroup by external_order_ref\nhaving count_if(reject_reason is not null) = 0\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_valid_order_refs\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33