{"data":{"node_info":{"unique_id":"model.retail_dw.rpt_reorder_recommendations"},"sql":"create or replace transient  table analytics.dbt_cbuckley_dev.rpt_reorder_recommendations\n    \n    \n    \n    \n    as (select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_dev.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_dev.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_reorder_recommendations\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:16.862932+00:00\n-- finished_at: 2026-07-30T12:50:18.821141+00:00\n-- elapsed: 2.0s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.rpt_reorder_recommendations\n-- query_id: 01c60e02-090c-f17e-0004-7d833f3946ce\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_dev.rpt_reorder_recommendations\n    \n    \n    \n    \n    as (select\n    stock.warehouse_id,\n    product.supplier_id,\n    stock.product_id,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) as recommended_order_qty,\n    product.unit_cost,\n    coalesce(stock.reorder_qty, config_values.default_reorder_qty) * coalesce(product.unit_cost, 0) as estimated_cost\nfrom analytics.dbt_cbuckley_dev.stg_stock_levels as stock\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = stock.product_id\n    and product.status = 'ACTIVE'\ncross join analytics.dbt_cbuckley_dev.int_config_values as config_values\nwhere stock.qty_on_hand - stock.qty_allocated + stock.qty_on_order\n    <= coalesce(stock.reorder_point, config_values.default_reorder_point)\n  and product.supplier_id is not null\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_reorder_recommendations\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:18.821156Z"}}
