{"data":{"compiled":"with non_usd_rates as (\n    select\n        orders.order_id,\n        fx.rate\n    from analytics.dbt_cbuckley_stored_proc.fct_orders as orders\n    left join analytics.dbt_cbuckley_stored_proc.int_fx_rates as fx\n        on fx.from_currency = orders.currency_code\n        and fx.to_currency = 'USD'\n        and fx.rate_date <= orders.order_date\n    where orders.currency_code <> 'USD'\n    qualify row_number() over (\n        partition by orders.order_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    orders.order_id,\n    case\n        when orders.currency_code = 'USD' then 1\n        else coalesce(non_usd_rates.rate, 1)\n    end as usd_rate\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\nleft join non_usd_rates\n    on non_usd_rates.order_id = orders.order_id","is_inline":false,"node_name":"int_order_usd_rates","output_format":"text","unique_id":"model.my_new_project.int_order_usd_rates"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019f1a21-51b9-7933-8844-04ce8fa3acbe","level":"info","msg":"with non_usd_rates as (\n    select\n        orders.order_id,\n        fx.rate\n    from analytics.dbt_cbuckley_stored_proc.fct_orders as orders\n    left join analytics.dbt_cbuckley_stored_proc.int_fx_rates as fx\n        on fx.from_currency = orders.currency_code\n        and fx.to_currency = 'USD'\n        and fx.rate_date <= orders.order_date\n    where orders.currency_code <> 'USD'\n    qualify row_number() over (\n        partition by orders.order_id\n        order by fx.rate_date desc nulls last\n    ) = 1\n)\n\nselect\n    orders.order_id,\n    case\n        when orders.currency_code = 'USD' then 1\n        else coalesce(non_usd_rates.rate, 1)\n    end as usd_rate\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\nleft join non_usd_rates\n    on non_usd_rates.order_id = orders.order_id","name":"CompiledNode","pid":56921,"thread":"tokio-rt-worker","ts":"2026-06-30T20:03:39.518114Z"}}
