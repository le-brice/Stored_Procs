{"data":{"compiled":"with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_stored_proc.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_stored_proc.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories","is_inline":false,"node_name":"int_product_categories","output_format":"text","unique_id":"model.my_new_project.int_product_categories"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019f1a22-537f-7733-b954-8ffdbb717d72","level":"info","msg":"with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_stored_proc.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_stored_proc.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories","name":"CompiledNode","pid":57034,"thread":"tokio-rt-worker","ts":"2026-06-30T20:04:45.459407Z"}}
