{"data":{"node_info":{"unique_id":"model.my_new_project.fct_journal_balance"},"sql":"create or replace transient  table analytics.dbt_cbuckley_stored_proc.fct_journal_balance\n    \n    \n    \n    \n    as (select\n    entry_date,\n    source,\n    round(sum(debit_amount), 4) as debit_amount,\n    round(sum(credit_amount), 4) as credit_amount,\n    round(sum(debit_amount) - sum(credit_amount), 4) as variance_amount,\n    abs(round(sum(debit_amount) - sum(credit_amount), 4)) <= 0.005 as is_balanced\nfrom analytics.dbt_cbuckley_stored_proc.fct_sales_journal_lines\ngroup by 1, 2\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a26-63b6-7ff1-b583-072798a7d36f\", \"node_id\": \"model.my_new_project.fct_journal_balance\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a26-63b6-7ff1-b583-072798a7d36f","level":"debug","msg":"-- created_at: 2026-06-30T20:09:57.465690+00:00\n-- finished_at: 2026-06-30T20:09:58.449986+00:00\n-- elapsed: 984ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.fct_journal_balance\n-- query_id: 01c566f9-0a0c-736f-0004-7d833bcb0b96\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_stored_proc.fct_journal_balance\n    \n    \n    \n    \n    as (select\n    entry_date,\n    source,\n    round(sum(debit_amount), 4) as debit_amount,\n    round(sum(credit_amount), 4) as credit_amount,\n    round(sum(debit_amount) - sum(credit_amount), 4) as variance_amount,\n    abs(round(sum(debit_amount) - sum(credit_amount), 4)) <= 0.005 as is_balanced\nfrom analytics.dbt_cbuckley_stored_proc.fct_sales_journal_lines\ngroup by 1, 2\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a26-63b6-7ff1-b583-072798a7d36f\", \"node_id\": \"model.my_new_project.fct_journal_balance\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","n