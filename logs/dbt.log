{"data":{"node_info":{"unique_id":"model.retail_dw.rpt_low_stock_report"},"sql":"create or replace transient  table analytics.dbt_cbuckley_dev.rpt_low_stock_report\n    \n    \n    \n    \n    as (select\n    snapshot.warehouse_id,\n    snapshot.product_id,\n    product.sku,\n    product.product_name,\n    supplier.supplier_name,\n    snapshot.qty_available,\n    stock.qty_on_order as on_order\nfrom analytics.dbt_cbuckley_dev.rpt_inventory_snapshot as snapshot\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = snapshot.product_id\nleft join analytics.dbt_cbuckley_dev.int_suppliers as supplier\n    on supplier.supplier_id = product.supplier_id\nleft join analytics.dbt_cbuckley_dev.stg_stock_levels as stock\n    on stock.warehouse_id = snapshot.warehouse_id\n    and stock.product_id = snapshot.product_id\nwhere snapshot.below_reorder = 1\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_low_stock_report\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:20.218930+00:00\n-- finished_at: 2026-07-30T12:50:21.874978+00:00\n-- elapsed: 1.7s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.rpt_low_stock_report\n-- query_id: 01c60e02-090c-e778-0004-7d833f390d46\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_dev.rpt_low_stock_report\n    \n    \n    \n    \n    as (select\n    snapshot.warehouse_id,\n    snapshot.product_id,\n    product.sku,\n    product.product_name,\n    supplier.supplier_name,\n    snapshot.qty_available,\n    stock.qty_on_order as on_order\nfrom analytics.dbt_cbuckley_dev.rpt_inventory_snapshot as snapshot\ninner join analytics.dbt_cbuckley_dev.int_product_master as product\n    on product.product_id = snapshot.product_id\nleft join analytics.dbt_cbuckley_dev.int_suppliers as supplier\n    on supplier.supplier_id = product.supplier_id\nleft join analytics.dbt_cbuckley_dev.stg_stock_levels as stock\n    on stock.warehouse_id = snapshot.warehouse_id\n    and stock.product_id = snapshot.product_id\nwhere snapshot.below_reorder = 1\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.rpt_low_stock_report\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:21.874989Z"}}
