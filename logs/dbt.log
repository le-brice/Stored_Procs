{"data":{"compiled":"with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_dev.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_dev.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_dev.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_dev.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom analytics.dbt_cbuckley_dev.stg_products\n\nunion all\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom raw_products","is_inline":false,"node_name":"int_product_master","output_format":"text","unique_id":"model.retail_dw.int_product_master"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019fb312-abc0-7191-a187-5ee2be101c48","level":"info","msg":"with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_dev.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_dev.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_dev.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_dev.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom analytics.dbt_cbuckley_dev.stg_products\n\nunion all\n\nselect\n    product_id,\n    sku,\n    product_name,\n    category_id,\n    supplier_id,\n    unit_cost,\n    list_price,\n    weight_g,\n    status\nfrom raw_products","name":"CompiledNode","pid":33272,"thread":"tokio-rt-worker","ts":"2026-07-30T12:49:33.690425Z"}}
