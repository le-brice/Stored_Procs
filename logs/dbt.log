{"data":{"node_info":{"unique_id":"model.retail_dw.int_product_categories"},"sql":"create or replace   view analytics.dbt_cbuckley_dev.int_product_categories\n  \n  \n  \n  \n  as (\n    with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_dev.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_dev.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_product_categories\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:13.239919+00:00\n-- finished_at: 2026-07-30T12:50:13.671037+00:00\n-- elapsed: 431ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.int_product_categories\n-- query_id: 01c60e02-090c-ee4d-0004-7d833f3937de\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_dev.int_product_categories\n  \n  \n  \n  \n  as (\n    with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_dev.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_dev.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.int_product_categories\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:13.671047Z"}}
