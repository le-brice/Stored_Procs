{"data":{"node_info":{"unique_id":"model.retail_dw.fct_order_lines"},"sql":"create or replace transient  table analytics.dbt_cbuckley_dev.fct_order_lines\n    \n    \n    \n    \n    as (with merged_lines as (\n    select\n        orders.external_order_ref,\n        dense_rank() over (order by orders.external_order_ref) + 100000 as order_id,\n        lines.product_id,\n        min(lines.row_id) as first_row_id,\n        sum(lines.qty) as qty,\n        min_by(lines.unit_price, lines.row_id) as unit_price,\n        min_by(lines.tax_rate, lines.row_id) as tax_rate\n    from analytics.dbt_cbuckley_dev.int_valid_order_refs as orders\n    inner join analytics.dbt_cbuckley_dev.int_order_line_inputs as lines\n        on lines.external_order_ref = orders.external_order_ref\n    group by orders.external_order_ref, lines.product_id\n)\n\nselect\n    order_id * 1000 + row_number() over (\n        partition by order_id\n        order by first_row_id\n    ) as order_line_id,\n    order_id,\n    row_number() over (\n        partition by order_id\n        order by first_row_id\n    ) as line_no,\n    product_id,\n    qty,\n    unit_price,\n    0::decimal(18, 4) as line_discount,\n    tax_rate,\n    round((unit_price * qty) * tax_rate, 4) as line_tax,\n    round((unit_price * qty) + ((unit_price * qty) * tax_rate), 4) as line_total\nfrom merged_lines\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.fct_order_lines\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-240e-7f23-83e3-da33cd5f0abe","level":"debug","msg":"-- created_at: 2026-07-30T12:50:21.143548+00:00\n-- finished_at: 2026-07-30T12:50:27.033890+00:00\n-- elapsed: 5.9s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.retail_dw.fct_order_lines\n-- query_id: 01c60e02-090c-ee4d-0004-7d833f39384a\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_dev.fct_order_lines\n    \n    \n    \n    \n    as (with merged_lines as (\n    select\n        orders.external_order_ref,\n        dense_rank() over (order by orders.external_order_ref) + 100000 as order_id,\n        lines.product_id,\n        min(lines.row_id) as first_row_id,\n        sum(lines.qty) as qty,\n        min_by(lines.unit_price, lines.row_id) as unit_price,\n        min_by(lines.tax_rate, lines.row_id) as tax_rate\n    from analytics.dbt_cbuckley_dev.int_valid_order_refs as orders\n    inner join analytics.dbt_cbuckley_dev.int_order_line_inputs as lines\n        on lines.external_order_ref = orders.external_order_ref\n    group by orders.external_order_ref, lines.product_id\n)\n\nselect\n    order_id * 1000 + row_number() over (\n        partition by order_id\n        order by first_row_id\n    ) as order_line_id,\n    order_id,\n    row_number() over (\n        partition by order_id\n        order by first_row_id\n    ) as line_no,\n    product_id,\n    qty,\n    unit_price,\n    0::decimal(18, 4) as line_discount,\n    tax_rate,\n    round((unit_price * qty) * tax_rate, 4) as line_tax,\n    round((unit_price * qty) + ((unit_price * qty) * tax_rate), 4) as line_total\nfrom merged_lines\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"model.retail_dw.fct_order_lines\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33324,"thread":"tokio-rt-worker","ts":"2026-07-30T12:50:27.033939Z"}}
