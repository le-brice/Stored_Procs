{"data":{"node_info":{"unique_id":"model.my_new_project.int_product_master"},"sql":"create or replace   view analytics.dbt_cbuckley_stored_proc.int_product_master\n  \n  \n  \n  \n  as (\n    with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_stored_proc.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_stored_proc.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_stored_proc.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect * from analytics.dbt_cbuckley_stored_proc.stg_products\n\nunion all\n\nselect * from raw_products\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.int_product_master\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a25-5137-7943-89dd-2848815b4923","level":"debug","msg":"-- created_at: 2026-06-30T20:08:19.302093+00:00\n-- finished_at: 2026-06-30T20:08:20.935643+00:00\n-- elapsed: 1.6s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.int_product_master\n-- query_id: 01c566f8-0a0c-6cd8-0004-7d833bcb17a6\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_stored_proc.int_product_master\n  \n  \n  \n  \n  as (\n    with raw_products as (\n    select\n        100000 + row_number() over (order by raw.sku) as product_id,\n        raw.sku,\n        raw.product_name,\n        cat.category_id,\n        sup.supplier_id,\n        raw.unit_cost,\n        raw.list_price,\n        null as weight_g,\n        'ACTIVE' as status\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products as raw\n    left join analytics.dbt_cbuckley_stored_proc.int_product_categories as cat\n        on cat.category_name = raw.category_name\n    left join analytics.dbt_cbuckley_stored_proc.int_suppliers as sup\n        on sup.supplier_name = raw.supplier_name\n    where raw.sku is not null\n      and raw.sku not in (select sku from analytics.dbt_cbuckley_stored_proc.stg_products)\n    qualify row_number() over (partition by raw.sku order by raw.row_id) = 1\n)\n\nselect * from analytics.dbt_cbuckley_stored_proc.stg_products\n\nunion all\n\nselect * from raw_products\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.int_product_master\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57102,"thread":"tokio-rt-worker","ts":"2026-06-30T20:08:20.935681Z"}}
