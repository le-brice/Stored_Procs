{"data":{"node_info":{"unique_id":"test.my_new_project.assert_order_totals_reconcile.00824ab001"},"sql":"select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005\n  \n  \n      \n    ) dbt_internal_test\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"test.my_new_project.assert_order_totals_reconcile.00824ab001\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a25-5137-7943-89dd-2848815b4923","level":"debug","msg":"-- created_at: 2026-06-30T20:08:53.957439+00:00\n-- finished_at: 2026-06-30T20:08:54.387304+00:00\n-- elapsed: 429ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: test.my_new_project.assert_order_totals_reconcile.00824ab001\n-- query_id: 01c566f8-0a0c-6cd9-0004-7d833bcaddda\n-- desc: execute adapter call\nselect\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005\n  \n  \n      \n    ) dbt_internal_test\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"test.my_new_project.assert_order_totals_reconcile.00824ab001\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57102,"thread":"tokio-rt-worker","ts":"2026-06-30T20:08:54.387326Z"}}
