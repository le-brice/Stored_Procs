{"data":{"node_info":{"unique_id":"test.retail_dw.assert_order_totals_reconcile"},"sql":"select\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_dev.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005\n  \n  \n      \n    ) dbt_internal_test\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"test.retail_dw.assert_order_totals_reconcile\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019fb313-e5df-7d10-8cc1-77f1a6c0cb89","level":"debug","msg":"-- created_at: 2026-07-30T12:51:02.685551+00:00\n-- finished_at: 2026-07-30T12:51:02.999355+00:00\n-- elapsed: 313ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: test.retail_dw.assert_order_totals_reconcile\n-- query_id: 01c60e03-090c-e778-0004-7d833f390dfa\n-- desc: execute adapter call\nselect\n      count(*) as failures,\n      count(*) != 0 as should_warn,\n      count(*) != 0 as should_error\n    from (\n      \n    \n  with line_totals as (\n    select\n        order_id,\n        round(sum(unit_price * qty), 4) as subtotal,\n        round(sum(line_tax), 4) as tax_total\n    from analytics.dbt_cbuckley_dev.fct_order_lines\n    group by order_id\n)\n\nselect\n    orders.order_id,\n    orders.subtotal,\n    line_totals.subtotal as line_subtotal,\n    orders.tax_total,\n    line_totals.tax_total as line_tax_total\nfrom analytics.dbt_cbuckley_dev.fct_orders as orders\ninner join line_totals\n    on line_totals.order_id = orders.order_id\nwhere abs(orders.subtotal - line_totals.subtotal) > 0.005\n   or abs(orders.tax_total - line_totals.tax_total) > 0.005\n  \n  \n      \n    ) dbt_internal_test\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"node_id\": \"test.retail_dw.assert_order_totals_reconcile\", \"profile_name\": \"default\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":33410,"thread":"tokio-rt-worker","ts":"2026-07-30T12:51:02.999367Z"}}
