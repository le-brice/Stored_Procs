{"data":{"node_info":{"unique_id":"model.my_new_project.stg_raw_products"},"sql":"create or replace   view analytics.dbt_cbuckley_stored_proc.stg_raw_products\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by sku, productname) as row_id,\n    nullif(trim(sku), '') as sku,\n    nullif(trim(productname), '') as product_name,\n    nullif(trim(categoryname), '') as category_name,\n    nullif(trim(suppliername), '') as supplier_name,\n    try_to_decimal(nullif(trim(unitcost), ''), 18, 4) as unit_cost,\n    try_to_decimal(nullif(trim(listprice), ''), 18, 4) as list_price\nfrom analytics.dbt_cbuckley_stored_proc.raw_product\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.stg_raw_products\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:12.168851+00:00\n-- finished_at: 2026-06-30T20:05:13.408432+00:00\n-- elapsed: 1.2s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.stg_raw_products\n-- query_id: 01c566f5-0a0c-6cd9-0004-7d833bcad82a\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_stored_proc.stg_raw_products\n  \n  \n  \n  \n  as (\n    select\n    row_number() over (order by sku, productname) as row_id,\n    nullif(trim(sku), '') as sku,\n    nullif(trim(productname), '') as product_name,\n    nullif(trim(categoryname), '') as category_name,\n    nullif(trim(suppliername), '') as supplier_name,\n    try_to_decimal(nullif(trim(unitcost), ''), 18, 4) as unit_cost,\n    try_to_decimal(nullif(trim(listprice), ''), 18, 4) as list_price\nfrom analytics.dbt_cbuckley_stored_proc.raw_product\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.stg_raw_products\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57042,"thread":"tokio-rt-worker","ts":"2026-06-30T20:05:13.408449Z"}}
