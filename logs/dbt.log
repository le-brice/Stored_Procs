{"data":{"node_info":{"unique_id":"model.my_new_project.fct_orders"},"sql":"create or replace transient  table analytics.dbt_cbuckley_stored_proc.fct_orders\n    \n    \n    \n    \n    as (with order_ids as (\n    select\n        dense_rank() over (order by external_order_ref) + 100000 as order_id,\n        external_order_ref,\n        customer_id,\n        order_date,\n        currency_code,\n        promo_code,\n        source_system\n    from analytics.dbt_cbuckley_stored_proc.int_valid_order_refs\n),\n\nline_totals as (\n    select\n        order_id,\n        sum(unit_price * qty) as subtotal,\n        sum(line_discount) as line_discount_total,\n        sum(line_tax) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n),\n\ndefault_warehouse as (\n    select warehouse.warehouse_id\n    from analytics.dbt_cbuckley_stored_proc.stg_warehouses as warehouse\n    cross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\n    where warehouse.warehouse_code = coalesce(config_values.default_warehouse_code, 'WH01')\n    qualify row_number() over (order by warehouse.warehouse_id) = 1\n)\n\nselect\n    order_ids.order_id,\n    'ORD-' || lpad(order_ids.order_id::varchar, 8, '0') as order_no,\n    order_ids.external_order_ref,\n    order_ids.customer_id,\n    order_ids.order_date,\n    'CONFIRMED' as status,\n    order_ids.currency_code,\n    promo.promotion_id,\n    coalesce(line_totals.subtotal, 0) as subtotal,\n    coalesce(promo.discount_total, 0) as discount_total,\n    coalesce(line_totals.tax_total, 0) as tax_total,\n    0::decimal(18, 4) as shipping_total,\n    coalesce(line_totals.subtotal, 0)\n        - coalesce(line_totals.line_discount_total, 0)\n        - coalesce(promo.discount_total, 0)\n        + coalesce(line_totals.tax_total, 0) as grand_total,\n    default_warehouse.warehouse_id,\n    order_ids.source_system,\n    promo.invalid_reason as promo_reject_reason\nfrom order_ids\nleft join line_totals\n    on line_totals.order_id = order_ids.order_id\nleft join analytics.dbt_cbuckley_stored_proc.int_order_promotions as promo\n    on promo.external_order_ref = order_ids.external_order_ref\ncross join default_warehouse\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.fct_orders\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a25-5137-7943-89dd-2848815b4923","level":"debug","msg":"-- created_at: 2026-06-30T20:08:36.932557+00:00\n-- finished_at: 2026-06-30T20:08:52.491802+00:00\n-- elapsed: 15.6s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.fct_orders\n-- query_id: 01c566f8-0a0c-6ce7-0004-7d833bcb3426\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_stored_proc.fct_orders\n    \n    \n    \n    \n    as (with order_ids as (\n    select\n        dense_rank() over (order by external_order_ref) + 100000 as order_id,\n        external_order_ref,\n        customer_id,\n        order_date,\n        currency_code,\n        promo_code,\n        source_system\n    from analytics.dbt_cbuckley_stored_proc.int_valid_order_refs\n),\n\nline_totals as (\n    select\n        order_id,\n        sum(unit_price * qty) as subtotal,\n        sum(line_discount) as line_discount_total,\n        sum(line_tax) as tax_total\n    from analytics.dbt_cbuckley_stored_proc.fct_order_lines\n    group by order_id\n),\n\ndefault_warehouse as (\n    select warehouse.warehouse_id\n    from analytics.dbt_cbuckley_stored_proc.stg_warehouses as warehouse\n    cross join analytics.dbt_cbuckley_stored_proc.int_config_values as config_values\n    where warehouse.warehouse_code = coalesce(config_values.default_warehouse_code, 'WH01')\n    qualify row_number() over (order by warehouse.warehouse_id) = 1\n)\n\nselect\n    order_ids.order_id,\n    'ORD-' || lpad(order_ids.order_id::varchar, 8, '0') as order_no,\n    order_ids.external_order_ref,\n    order_ids.customer_id,\n    order_ids.order_date,\n    'CONFIRMED' as status,\n    order_ids.currency_code,\n    promo.promotion_id,\n    coalesce(line_totals.subtotal, 0) as subtotal,\n    coalesce(promo.discount_total, 0) as discount_total,\n    coalesce(line_totals.tax_total, 0) as tax_total,\n    0::decimal(18, 4) as shipping_total,\n    coalesce(line_totals.subtotal, 0)\n        - coalesce(line_totals.line_discount_total, 0)\n        - coalesce(promo.discount_total, 0)\n        + coalesce(line_totals.tax_total, 0) as grand_total,\n    default_warehouse.warehouse_id,\n    order_ids.source_system,\n    promo.invalid_reason as promo_reject_reason\nfrom order_ids\nleft join line_totals\n    on line_totals.order_id = order_ids.order_id\nleft join analytics.dbt_cbuckley_stored_proc.int_order_promotions as promo\n    on promo.external_order_ref = order_ids.external_order_ref\ncross join default_warehouse\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.fct_orders\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57102,"thread":"tokio-rt-worker","ts":"2026-06-30T20:08:52.491835Z"}}
