{"data":{"node_info":{"unique_id":"model.my_new_project.int_product_categories"},"sql":"create or replace   view analytics.dbt_cbuckley_stored_proc.int_product_categories\n  \n  \n  \n  \n  as (\n    with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_stored_proc.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_stored_proc.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.int_product_categories\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a22-796b-7ca3-9cf1-517e0a78b160","level":"debug","msg":"-- created_at: 2026-06-30T20:05:13.725112+00:00\n-- finished_at: 2026-06-30T20:05:14.639510+00:00\n-- elapsed: 914ms\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.int_product_categories\n-- query_id: 01c566f5-0a0c-6cc8-0004-7d833bcb200a\n-- desc: execute adapter call\ncreate or replace   view analytics.dbt_cbuckley_stored_proc.int_product_categories\n  \n  \n  \n  \n  as (\n    with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_stored_proc.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_stored_proc.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_stored_proc.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories\n  )\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a22-796b-7ca3-9cf1-517e0a78b160\", \"node_id\": \"model.my_new_project.int_product_categories\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57042,"thread":"tokio-rt-worker","ts":"2026-06-30T20:05:14.639541Z"}}
