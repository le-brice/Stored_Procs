{"data":{"node_info":{"unique_id":"model.my_new_project.rpt_top_products_by_revenue"},"sql":"create or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_top_products_by_revenue\n    \n    \n    \n    \n    as (select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join analytics.dbt_cbuckley_stored_proc.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.rpt_top_products_by_revenue\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */"},"info":{"category":"","code":"E017","extra":{},"invocation_id":"019f1a25-5137-7943-89dd-2848815b4923","level":"debug","msg":"-- created_at: 2026-06-30T20:08:54.784469+00:00\n-- finished_at: 2026-06-30T20:08:57.161660+00:00\n-- elapsed: 2.4s\n-- outcome: success\n-- dialect: snowflake\n-- node_id: model.my_new_project.rpt_top_products_by_revenue\n-- query_id: 01c566f8-0a0c-736f-0004-7d833bcb0a4e\n-- desc: execute adapter call\ncreate or replace transient  table analytics.dbt_cbuckley_stored_proc.rpt_top_products_by_revenue\n    \n    \n    \n    \n    as (select\n    product.product_id,\n    product.product_name,\n    product.category_id,\n    sum(lines.unit_price * lines.qty - lines.line_discount) as net_revenue,\n    sum(lines.qty) as units_sold,\n    min(orders.order_date) as first_order_date,\n    max(orders.order_date) as last_order_date\nfrom analytics.dbt_cbuckley_stored_proc.fct_orders as orders\ninner join analytics.dbt_cbuckley_stored_proc.fct_order_lines as lines\n    on lines.order_id = orders.order_id\ninner join analytics.dbt_cbuckley_stored_proc.int_product_master as product\n    on product.product_id = lines.product_id\nwhere orders.status not in ('CANCELLED', 'NEW')\ngroup by 1, 2, 3\n    )\n\n/* {\"app\": \"dbt\", \"dbt_version\": \"2.0.0\", \"invocation_id\": \"019f1a25-5137-7943-89dd-2848815b4923\", \"node_id\": \"model.my_new_project.rpt_top_products_by_revenue\", \"profile_name\": \"storedProcs\", \"target_name\": \"dev\"} */;","name":"SQLQuery","pid":57102,"thread":"tokio-rt-worker","ts":"2026-06-30T20:08:57.161693Z"}}
