{"data":{"compiled":"with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_dev.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_dev.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories","is_inline":false,"node_name":"int_product_categories","output_format":"text","unique_id":"model.retail_dw.int_product_categories"},"info":{"category":"","code":"Q042","extra":{},"invocation_id":"019fb312-abc0-7191-a187-5ee2be101c48","level":"info","msg":"with raw_categories as (\n    select distinct category_name\n    from analytics.dbt_cbuckley_dev.stg_raw_products\n    where category_name is not null\n      and category_name not in (\n          select category_name from analytics.dbt_cbuckley_dev.stg_product_categories\n      )\n)\n\nselect\n    category_id,\n    category_name,\n    parent_category_id,\n    default_margin_pct\nfrom analytics.dbt_cbuckley_dev.stg_product_categories\n\nunion all\n\nselect\n    100000 + row_number() over (order by category_name) as category_id,\n    category_name,\n    null as parent_category_id,\n    null as default_margin_pct\nfrom raw_categories","name":"CompiledNode","pid":33272,"thread":"tokio-rt-worker","ts":"2026-07-30T12:49:33.712861Z"}}
